# Copy to .env.local and fill in. Never commit .env.local.
# With the two NEXT_PUBLIC values left empty, `npm run dev` runs in demo mode
# (built-in synthetic data, no login).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" / "publishable" key. Safe for the browser; access is limited by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service_role" / "secret" key. Bypasses Row Level Security.
# Only used by the local setup scripts (npm run db:seed / db:bootstrap).
# Do NOT add this to Vercel — the deployed app never needs it.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key, for sorting unfamiliar merchants with AI (optional).
# Server-only: never prefix with NEXT_PUBLIC_. Add it to Vercel too.
# Only merchant names and the bank's category label are ever sent.
ANTHROPIC_API_KEY=

# Used by the setup scripts when creating the two logins.
SEED_USER_PASSWORD=
SEED_PERSON1_NAME=John
SEED_PERSON1_EMAIL=john@example.com
SEED_PERSON2_NAME=Jane
SEED_PERSON2_EMAIL=jane@example.com
SEED_HOUSEHOLD_NAME=John & Jane

# Optional. Decides what "today" and "this week" mean. Default: America/New_York
HOUSEHOLD_TIME_ZONE=America/New_York

# Optional. First day of the week for Sunday Review: sunday (default) or monday.
HOUSEHOLD_WEEK_STARTS_ON=sunday

# Optional. Point out "Other" spending above this many dollars in a month. Default 200.
# HOUSEHOLD_OTHER_ALERT_DOLLARS=200

# Optional. How shared (joint account) bills show in each person's view:
# separate (default) = under Shared, plus what each person paid in; split = an equal share each.
# HOUSEHOLD_SHARED_SPENDING_IN_PERSONAL=separate

# Optional. Lets a production build run on synthetic data when Supabase is not configured.
# DEMO_MODE=true
